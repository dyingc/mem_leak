diff --git a/infer/src/absint/HeapTrace.ml b/infer/src/absint/HeapTrace.ml
new file mode 100644
index 0000000..7dfcfde
--- /dev/null
+++ b/infer/src/absint/HeapTrace.ml
@@ -0,0 +1,131 @@
+(*
+ * Diagnostic per-procedure managed-heap trace. Inert unless the environment variable
+ * INFER_HEAP_TRACE=<path prefix> is set; then one line per event is appended to
+ * <path prefix>.<pid>. If INFER_HEAP_TRACE_COMPACT=1 is also set, a [Gc.compact ()] is
+ * forced at the end of every scheduled target (after caches are cleared) and the heap size
+ * after compaction is logged, which approximates the memory retained across targets.
+ *)
+
+open! IStd
+
+let channel =
+  lazy
+    (Option.map (Sys.getenv "INFER_HEAP_TRACE") ~f:(fun path ->
+         Out_channel.create ~append:true
+           (Printf.sprintf "%s.%d" path (Pid.to_int (Unix.getpid ()))) ) )
+
+
+let compact_mode = lazy (Sys.getenv "INFER_HEAP_TRACE_COMPACT")
+
+let compact_at_target_end = lazy (Option.is_some (Lazy.force compact_mode))
+
+let compact_at_toplevel_proc =
+  lazy (Option.exists (Lazy.force compact_mode) ~f:(String.equal "toplevel"))
+
+(* diagnostic knob: clear the in-memory summary cache after every top-level procedure of a file *)
+let clear_summary_cache_per_toplevel_proc =
+  lazy (Option.is_some (Sys.getenv "INFER_CLEAR_SUMMARY_CACHE_PER_PROC"))
+
+let enabled () = Option.is_some (Lazy.force channel)
+
+(* hook set by the backend to measure the summary cache: (entries, reachable words) *)
+let cache_stats : (unit -> int * int) ref = ref (fun () -> (0, 0))
+
+let last_cache_measure_heap = ref 0
+
+let log_cache_stats ~event ?proc () =
+  match Lazy.force channel with
+  | None ->
+      ()
+  | Some oc ->
+      let entries, words = !cache_stats () in
+      Printf.fprintf oc "%.3f %s cache_entries=%d cache_words=%d proc=%s\n" (Unix.gettimeofday ())
+        event entries words (Option.value proc ~default:"-") ;
+      Out_channel.flush oc
+
+let log ~event ?(nesting = 0) ?file ?proc () =
+  match Lazy.force channel with
+  | None ->
+      ()
+  | Some oc ->
+      let st = Gc.quick_stat () in
+      Printf.fprintf oc
+        "%.3f %s nesting=%d heap_words=%d top_heap_words=%d minor=%d major=%d compact=%d \
+         file=%s proc=%s\n"
+        (Unix.gettimeofday ()) event nesting st.heap_words st.top_heap_words
+        st.minor_collections st.major_collections st.compactions
+        (Option.value file ~default:"-")
+        (Option.value proc ~default:"-") ;
+      Out_channel.flush oc
+
+
+(* stack of frames for nested on-demand analyses: (heap at start, heap growth of direct children) *)
+let frames : (int * int ref) list ref = ref []
+
+let child_growth_of_current_frame () =
+  match !frames with (_, acc) :: _ -> !acc | [] -> 0
+
+
+let log_proc ~event ~nesting callee_pname (attrs : ProcAttributes.t) =
+  if enabled () then (
+    let heap = (Gc.quick_stat ()).heap_words in
+    ( match event with
+    | "start" ->
+        frames := (heap, ref 0) :: !frames
+    | "end" | "end-error" -> (
+      match !frames with
+      | (heap0, _) :: rest ->
+          frames := rest ;
+          (match rest with (_, acc) :: _ -> acc := !acc + (heap - heap0) | [] -> ())
+      | [] ->
+          () )
+    | _ ->
+        () ) ;
+    log ~event ~nesting
+      ~file:(SourceFile.to_string attrs.translation_unit)
+      ~proc:(Procname.to_string callee_pname) () )
+
+
+let target_done ~target =
+  if enabled () then (
+    log ~event:"target-done" ~file:target () ;
+    last_cache_measure_heap := 0 ;
+    if Lazy.force compact_at_target_end then (
+      Gc.compact () ;
+      log ~event:"target-done-compacted" ~file:target () ) )
+
+
+let toplevel_proc_done ~proc =
+  if enabled () then (
+    log ~event:"toplevel-done" ~proc () ;
+    (let heap = (Gc.quick_stat ()).heap_words in
+     (* measure the cache whenever the heap grew by >= 256MB since the last measurement *)
+     if heap - !last_cache_measure_heap >= 32 * 1024 * 1024 then (
+       last_cache_measure_heap := heap ;
+       log_cache_stats ~event:"cache-stats" ~proc () ) ) ;
+    if Lazy.force compact_at_toplevel_proc then (
+      Gc.compact () ;
+      log ~event:"toplevel-done-compacted" ~proc () ) )
+
+
+(* instruction-level burst trace: log any single Pulse instruction execution (one disjunct) that
+   grows the major heap by at least INFER_HEAP_TRACE_INSTR_MB megabytes (default 64) *)
+let instr_burst_words =
+  let v =
+    lazy
+      ( (match Sys.getenv "INFER_HEAP_TRACE_INSTR_MB" with Some s -> int_of_string s | None -> 64)
+      * 1024 * 1024 / 8 )
+  in
+  fun () -> Lazy.force v
+
+
+let log_instr ~heap_before ~heap_after ~child_growth ~proc ~n_out ~instr =
+  match Lazy.force channel with
+  | None ->
+      ()
+  | Some oc ->
+      Printf.fprintf oc
+        "%.3f instr-burst heap_before=%d heap_after=%d child_growth=%d n_out=%d proc=%s instr=%s\n"
+        (Unix.gettimeofday ()) heap_before heap_after child_growth n_out proc
+        (String.filter instr ~f:(fun c -> not (Char.equal c '\n'))) ;
+      Out_channel.flush oc
