diff --git a/infer/src/base/Config.ml b/infer/src/base/Config.ml
index 808dbe7..647c839 100644
--- a/infer/src/base/Config.ml
+++ b/infer/src/base/Config.ml
@@ -2559,6 +2559,14 @@ and pulse_model_free_pattern =
      call is dispatched to global function pointers)."
 
 
+and pulse_model_free_arg_pattern =
+  CLOpt.mk_string_list ~long:"pulse-model-free-arg-pattern" ~meta:"N:regex"
+    ~in_help:InferCommand.[(Analyze, manual_pulse)]
+    "Like $(b,--pulse-model-free-pattern) but the pointer to be freed is argument number N \
+     (0-based) of the matched function, e.g. $(b,1:^\\\\(my_free\\\\|other_free\\\\)$). May be \
+     given several times, once per argument position."
+
+
 and pulse_model_malloc_pattern =
   CLOpt.mk_string_opt ~long:"pulse-model-malloc-pattern"
     ~in_help:InferCommand.[(Analyze, manual_pulse)]
@@ -4514,6 +4522,19 @@ and pulse_model_cheap_copy_type =
 
 and pulse_model_free_pattern = Option.map ~f:Str.regexp !pulse_model_free_pattern
 
+and pulse_model_free_arg_pattern =
+  RevList.to_list !pulse_model_free_arg_pattern
+  |> List.map ~f:(fun spec ->
+         match String.lsplit2 spec ~on:':' with
+         | Some (n, re) -> (
+           match int_of_string_opt n with
+           | Some n when n >= 0 ->
+               (n, Str.regexp re)
+           | _ ->
+               L.die UserError "--pulse-model-free-arg-pattern: bad argument index in '%s'" spec )
+         | None ->
+             L.die UserError "--pulse-model-free-arg-pattern expects N:regex, got '%s'" spec )
+
 and pulse_model_malloc_pattern = Option.map ~f:Str.regexp !pulse_model_malloc_pattern
 
 and pulse_model_realloc_pattern = Option.map ~f:Str.regexp !pulse_model_realloc_pattern
