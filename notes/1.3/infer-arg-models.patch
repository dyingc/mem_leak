+(** parse the [N:regex] specifications shared by --pulse-model-{free,alloc}-arg-pattern *)
+let parse_arg_index_patterns option_name specs =
+  List.map specs ~f:(fun spec ->
+      match String.lsplit2 spec ~on:':' with
