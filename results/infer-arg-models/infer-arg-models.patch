@@ -67,6 +67,26 @@ let custom_alloc_not_null model_data astate =
     astate
 
 
+(* --pulse-model-alloc-arg-pattern N:regex — the matched function acquires a resource and stores it
+   into [*argN] instead of returning it. Only applied when argument N really is a pointer to a
+   pointer, so that configuring the wrong index cannot mark an unrelated value as allocated. *)
+let is_out_param_typ (typ : Typ.t) =
+  match typ.desc with Typ.Tptr (pointee, _) -> Typ.is_pointer pointee | _ -> false
+
+
+let alloc_out_arg (out_arg : DSL.aval FuncArg.t) : model =
+  let open DSL.Syntax in
+  start_model
+  @@ let* {callee_procname} = get_data in
+     if not (is_out_param_typ out_arg.FuncArg.typ) then ret ()
+     else
+       let desc = Procname.to_string callee_procname in
+       let* acquired = mk_fresh ~model_desc:desc ~more:"(out parameter)" () in
+       let* () = allocation (CustomMalloc callee_procname) acquired in
+       let* () = and_positive acquired in
+       write_deref ~ref:out_arg.FuncArg.arg_payload ~obj:acquired
+
+
 let realloc_common allocator pointer size : model =
  fun data astate non_disj ->
   free pointer data astate non_disj
@@ -143,7 +163,71 @@ let matchers : matcher list =
         Str.string_match r s 0 )
   in
   let map_context_tenv f (x, _) = f x in
-  [ +BuiltinDecl.(match_builtin free) <>$ capt_arg $--> free
+  let match_regexp r (_tenv, proc_name) _ = Str.string_match r (Procname.to_string proc_name) 0 in
+  (* --pulse-model-free-arg-pattern N:regex — free argument number N of matching functions *)
+  let free_arg_matchers =
+    List.map Config.pulse_model_free_arg_pattern ~f:(fun (n, r) ->
+        match n with
+        | 0 ->
+            +match_regexp r <>$ capt_arg $+...$--> free
+        | 1 ->
+            +match_regexp r <>$ any_arg $+ capt_arg $+...$--> free
+        | 2 ->
+            +match_regexp r <>$ any_arg $+ any_arg $+ capt_arg $+...$--> free
+        | 3 ->
+            +match_regexp r <>$ any_arg $+ any_arg $+ any_arg $+ capt_arg $+...$--> free
+        | 4 ->
+            +match_regexp r <>$ any_arg $+ any_arg $+ any_arg $+ any_arg $+ capt_arg $+...$--> free
+        | 5 ->
+            +match_regexp r
+            <>$ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ capt_arg
+            $+...$--> free
+        | 6 ->
+            +match_regexp r
+            <>$ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ capt_arg
+            $+...$--> free
+        | 7 ->
+            +match_regexp r
+            <>$ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg
+            $+ capt_arg $+...$--> free
+        | _ ->
+            Logging.die UserError "--pulse-model-free-arg-pattern: argument index %d not supported (max 7)"
+              n )
+  in
+  (* --pulse-model-alloc-arg-pattern N:regex — acquire a resource through out parameter N *)
+  let alloc_arg_matchers =
+    List.map Config.pulse_model_alloc_arg_pattern ~f:(fun (n, r) ->
+        match n with
+        | 0 ->
+            +match_regexp r <>$ capt_arg $+...$--> alloc_out_arg
+        | 1 ->
+            +match_regexp r <>$ any_arg $+ capt_arg $+...$--> alloc_out_arg
+        | 2 ->
+            +match_regexp r <>$ any_arg $+ any_arg $+ capt_arg $+...$--> alloc_out_arg
+        | 3 ->
+            +match_regexp r <>$ any_arg $+ any_arg $+ any_arg $+ capt_arg $+...$--> alloc_out_arg
+        | 4 ->
+            +match_regexp r
+            <>$ any_arg $+ any_arg $+ any_arg $+ any_arg $+ capt_arg
+            $+...$--> alloc_out_arg
+        | 5 ->
+            +match_regexp r
+            <>$ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ capt_arg
+            $+...$--> alloc_out_arg
+        | 6 ->
+            +match_regexp r
+            <>$ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ capt_arg
+            $+...$--> alloc_out_arg
+        | 7 ->
+            +match_regexp r
+            <>$ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg $+ any_arg
+            $+ capt_arg $+...$--> alloc_out_arg
+        | _ ->
+            Logging.die UserError
+              "--pulse-model-alloc-arg-pattern: argument index %d not supported (max 7)" n )
+  in
+  free_arg_matchers
+  @ [ +BuiltinDecl.(match_builtin free) <>$ capt_arg $--> free
   ; +match_regexp_opt Config.pulse_model_free_pattern <>$ capt_arg $+...$--> free
   ; -"realloc" <>$ capt_arg $+ capt_exp $--> realloc
   ; +match_regexp_opt Config.pulse_model_realloc_pattern
@@ -161,4 +245,5 @@ let matchers : matcher list =
