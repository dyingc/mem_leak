--- /dev/null
+++ b/infer/src/base/MemoryPressure.mli
@@ -0,0 +1,55 @@
+(*
+ * Memory-pressure checkpoints that are reachable from inside a single procedure analysis.
+ * See MemoryPressure.ml for why this exists.
+ *)
+
+open! IStd
+
+exception OverHardLimit of int
+
+val heap_words : unit -> int
+
+val is_enabled : unit -> bool
+(** whether any soft or hard limit is configured *)
+
+val hard_limit : unit -> int option
+
+val note_abort : unit -> unit
+(** count a procedure the analysis gave up on, for the end-of-analysis summary *)
+
+val log_configuration : unit -> unit
+(** one line at the start of the analysis saying what is bounded and what is not *)
+
+val log_summary : unit -> unit
+(** one line at the end with the observed peaks, reliefs and omissions *)
+
+val enter_procedure : unit -> unit
+(** record the heap size at the start of a procedure analysis *)
+
+val exit_procedure : unit -> unit
+
+val heap_at_current_procedure_start : unit -> int option
+(** heap size when the innermost procedure analysis started, so a record of giving up on it can
+    say how much of the memory that procedure itself is responsible for *)
+
+val evict_hook : (unit -> unit) ref
+(** set by the backend to drop the least-recently-used half of the summary cache *)
+
+val trace_hook : (event:string -> before:int -> after:int -> unit) ref
+
+val check : unit -> int option
+
+val check_with_heap : int -> int option
+(** like {!check} but reuses a heap size the caller has already measured *)
+(** relieve memory pressure losslessly if over the soft limit; return the heap size if still over
+    the hard limit *)
+
+val check_sampled : unit -> int option
+(** like {!check} but only does the work every so many calls; for the inner loops of the analysis,
+    which run far more often than instruction boundaries *)
+
+val check_exn : unit -> unit
+(** like {!check} but raises {!OverHardLimit}; only for callers that record the omission *)
+
+val check_sampled_exn : unit -> unit
+(** sampled variant of {!check_exn} for the inner loops *)
