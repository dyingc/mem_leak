diff --git a/infer/src/base/MemoryPressure.ml b/infer/src/base/MemoryPressure.ml
new file mode 100644
index 0000000..a5bb2f8
--- /dev/null
+++ b/infer/src/base/MemoryPressure.ml
@@ -0,0 +1,363 @@
+(*
+ * Reachable memory-pressure checkpoints.
+ *
+ * Pulse can allocate gigabytes *inside* the analysis of a single procedure: inside one call
+ * instruction that applies a callee summary to every disjunct
+ * ([PulseCallOperations.call_aux]), inside a join/widen, or while building the summary of a
+ * procedure ([PulseSummary.of_posts]). None of those places used to observe memory:
+ *   - [--pulse-max-heap] was checked at exactly one place, the top of
+ *     [PulseTransferFunctions.exec_instr], i.e. only at instruction boundaries;
+ *   - the summary cache was only ever trimmed from [Summary.OnDisk.add], i.e. between
+ *     procedures, and cleared between scheduled targets.
+ * So a run that grows past the address-space limit inside one procedure is killed by the OCaml
+ * runtime ("Fatal error: out of memory") without either mechanism ever running.
+ *
+ * This module provides one cheap function those inner loops can call. It first relieves memory
+ * pressure *losslessly* (evict database-backed cached summaries, then collect), and only then
+ * reports that the heap is still over the hard limit, so the caller can give up on the current
+ * procedure explicitly -- and record that omission -- instead of losing the whole run.
+ *)
+
+open! IStd
+module L = Logging
+
+exception OverHardLimit of int
+(** raised by {!check_exn} when the managed heap is over the hard limit even after relief; the
+    payload is the heap size in words *)
+
+let heap_words () = (Gc.quick_stat ()).heap_words
+
+(** virtual size of this process in words, from /proc/self/statm (first field is in pages). This is
+    the quantity the OCaml runtime fails to extend when it aborts with "Fatal error: out of
+    memory" under RLIMIT_AS, and it includes what the managed heap does not: the compaction
+    transient, native allocations, and the SQLite copies of serialised summaries. *)
+let page_words = 4096 / (Sys.word_size_in_bits / 8)
+
+let vm_words () =
+  try
+    let line = In_channel.read_all "/proc/self/statm" in
+    match String.split line ~on:' ' with
+    | size :: _ ->
+        Some (int_of_string size * page_words)
+    | [] ->
+        None
+  with _ -> None
+
+let words_per_GB = 1024 * 1024 * (1024 / (Sys.word_size_in_bits / 8))
+
+(** address-space limit of this process (RLIMIT_AS) in words, if finite *)
+let address_space_limit_words =
+  lazy
+    (let path = "/proc/self/limits" in
+     if not (ISys.file_exists path) then None
+     else
+       try
+         In_channel.read_lines path
+         |> List.find_map ~f:(fun line ->
+                if String.is_prefix line ~prefix:"Max address space" then
+                  let rest = String.drop_prefix line (String.length "Max address space") in
+                  match String.split rest ~on:' ' |> List.filter ~f:(Fn.non String.is_empty) with
+                  | soft :: _ -> (
+                    match int_of_string_opt soft with
+                    | Some bytes ->
+                        Some (bytes / (Sys.word_size_in_bits / 8))
+                    | None ->
+                        None )
+                  | [] ->
+                      None
+                else None )
+       with _ -> None )
+
+
+let percent_of_address_space percent =
+  if percent <= 0 then None
+  else
+    Lazy.force address_space_limit_words
+    |> Option.map ~f:(fun limit -> limit / 100 * percent)
+
+
+(** heap size at which we start relieving pressure losslessly *)
+let soft_limit_words =
+  lazy
+    (let from_option =
+       if Config.summary_cache_max_heap_GB > 0 then
+         Some (Config.summary_cache_max_heap_GB * words_per_GB)
+       else None
+     in
+     (* start relieving well before the ceiling so the lossless path has a chance to work *)
+     let from_rlimit =
+       percent_of_address_space Config.max_heap_percent_of_address_space
+       |> Option.map ~f:(fun ceiling -> ceiling * 2 / 3)
+     in
+     match (from_option, from_rlimit) with
+     | Some a, Some b ->
+         Some (min a b)
+     | (Some _ as x), None | None, (Some _ as x) ->
+         x
+     | None, None ->
+         None )
+
+
+(** heap size at which the current procedure is given up on, explicitly *)
+let hard_limit_words =
+  lazy
+    (let from_option = Config.pulse_max_heap in
+     let from_rlimit = percent_of_address_space Config.max_heap_percent_of_address_space in
+     match (from_option, from_rlimit) with
+     | Some a, Some b ->
+         Some (min a b)
+     | (Some _ as x), None | None, (Some _ as x) ->
+         x
+     | None, None ->
+         None )
+
+
+let is_enabled () =
+  Option.is_some (Lazy.force soft_limit_words) || Option.is_some (Lazy.force hard_limit_words)
+
+
+(** set by the backend: drop the least-recently-used half of the summary cache. Cached summaries
+    are written to the results database before they are cached, so this only costs the time to
+    read them back. *)
+(* Heap size when each procedure analysis started, innermost last. The procedure that is given up
+   on is the innermost one running when the ceiling is crossed, which is not necessarily the one
+   that filled memory: a small callee can be started by a caller that has already accumulated
+   gigabytes. Recording the heap at its own start lets the omission record distinguish the two. *)
+let procedure_heap_stack : int list ref = ref []
+
+let enter_procedure () =
+  if is_enabled () then procedure_heap_stack := heap_words () :: !procedure_heap_stack
+
+
+let exit_procedure () =
+  match !procedure_heap_stack with _ :: tl -> procedure_heap_stack := tl | [] -> ()
+
+
+let heap_at_current_procedure_start () = List.hd !procedure_heap_stack
+
+
+let evict_hook : (unit -> unit) ref = ref (fun () -> ())
+
+
+
+(** set by the diagnostics: log a relief event *)
+let trace_hook : (event:string -> before:int -> after:int -> unit) ref =
+  ref (fun ~event:_ ~before:_ ~after:_ -> ())
+
+(* Observed peaks and crossings, so that a run that still dies can be diagnosed from [logs] alone,
+   without having to enable the JSONL trace. *)
+let peak_heap = ref 0
+
+let peak_vm = ref 0
+
+let aborts = ref 0
+
+let reported_fractions = ref []
+
+let note_abort () = incr aborts
+
+let report_crossings in_use =
+  match Lazy.force hard_limit_words with
+  | None ->
+      ()
+  | Some ceiling ->
+      let percent = if ceiling <= 0 then 0 else in_use * 100 / ceiling in
+      let step = if percent >= 90 then 90 else if percent >= 75 then 75 else if percent >= 50 then 50 else 0 in
+      if step > 0 && not (List.mem !reported_fractions step ~equal:Int.equal) then (
+        reported_fractions := step :: !reported_fractions ;
+        L.progress
+          "Memory: %d%% of the ceiling in use (%d words of %d; heap %d words). Above the ceiling \
+           the analysis of the current procedure is given up on and recorded in \
+           pulse/oom-aborted-procedures-<pid>.txt@."
+          percent in_use ceiling (heap_words ()) )
+
+
+let last_relief = ref None
+
+let base_relief_interval_ns =
+  Int64.(of_int Config.compaction_minimum_interval_s * 1_000_000_000L)
+
+
+let max_relief_interval_ns = Int64.(600L * 1_000_000_000L)
+
+(* Relief is best-effort: when a procedure's own live state is what fills memory there is nothing
+   in the cache to drop and a full major collection frees nothing. Repeating it every
+   [compaction_minimum_interval_s] then costs a large fraction of the run for no benefit (measured:
+   a Vim translation unit went from 750s to over 1800s). So back off exponentially whenever a
+   relief does not free a worthwhile amount, and reset as soon as one does. The hard ceiling, not
+   the relief, is what keeps the process alive. *)
+let relief_interval_ns = ref base_relief_interval_ns
+
+(* compaction moves the whole heap; stop paying for it once it stops giving memory back *)
+let compaction_worth_it = ref true
+
+let relief_interval_elapsed () =
+  match !last_relief with
+  | None ->
+      true
+  | Some counter ->
+      Int64.(Mtime.Span.to_uint64_ns (Mtime_clock.count counter) >= !relief_interval_ns)
+
+
+(** Lossless relief: drop database-backed cached summaries, then collect. [Gc.full_major] first
+    because it needs no extra address space; compact only if that was not enough, since
+    compaction briefly needs a second heap-sized chunk. *)
+let relieve () =
+  let before = heap_words () in
+  !evict_hook () ;
+  Gc.full_major () ;
+  let after_major = heap_words () in
+  let after =
+    match Lazy.force soft_limit_words with
+    | Some soft when after_major >= soft && !compaction_worth_it ->
+        let before_compact = after_major in
+        Gc.compact () ;
+        let after_compact = heap_words () in
+        compaction_worth_it := before_compact - after_compact >= before_compact / 20 ;
+        after_compact
+    | _ ->
+        after_major
+  in
+  last_relief := Some (Mtime_clock.counter ()) ;
+  ( if before - after < before / 10 then
+      (* freed less than a tenth: do not pay for this again soon *)
+      relief_interval_ns :=
+        Int64.min max_relief_interval_ns Int64.(!relief_interval_ns * 2L)
+    else relief_interval_ns := base_relief_interval_ns ) ;
+  Stats.incr_memory_pressure_reliefs () ;
+  !trace_hook ~event:"memory-pressure-relief" ~before ~after ;
+  L.debug Analysis Quiet
+    "memory pressure: heap was %d words, after eviction+GC %d words (soft limit %d, next relief \
+     not before %Ldms)@\n"
+    before after
+    (Option.value (Lazy.force soft_limit_words) ~default:0)
+    Int64.(!relief_interval_ns / 1_000_000L) ;
+  after
+
+
+(* reading /proc costs a syscall, so only do it once the managed heap is big enough that the
+   address space could plausibly be at risk, and at most once every [vm_recheck_calls] checks *)
+let vm_recheck_calls = 256
+
+let calls_since_vm_read = ref 0
+
+let last_vm = ref 0
+
+(* [vm_words] costs a syscall, so it is rate-limited by the call counter alone. Conditioning it on
+   the heap being high would mean one syscall per Pulse instruction for the whole second half of a
+   large procedure -- measured at +90% wall time on a Vim translation unit. *)
+let current_vm_words ~heap =
+  incr calls_since_vm_read ;
+  if !calls_since_vm_read >= vm_recheck_calls then (
+    calls_since_vm_read := 0 ;
+    match vm_words () with Some vm -> last_vm := vm ; vm | None -> heap )
+  else max !last_vm heap
+
+
+(** Cheap checkpoint: relieve pressure if we are over the soft limit, and report the memory in use
+    if we are still over the hard limit. Safe to call from anywhere in the analysis: the relief
+    only drops caches that are recoverable from the results database. *)
+let check_with_heap heap =
+  let soft = Lazy.force soft_limit_words in
+  let hard = Lazy.force hard_limit_words in
+  match (soft, hard) with
+  | None, None ->
+      None
+  | _ ->
+      (* the watermark keeps the fast path free of both syscalls and extra Gc.quick_stat calls
+         until memory is actually a concern *)
+      let watermark =
+        match (soft, hard) with
+        | Some s, _ ->
+            s / 2
+        | None, Some h ->
+            h / 4
+        | None, None ->
+            Int.max_value
+      in
+      if heap < watermark && !last_vm < watermark then (
+        incr calls_since_vm_read ;
+        if !calls_since_vm_read >= vm_recheck_calls then (
+          calls_since_vm_read := 0 ;
+          Option.iter (vm_words ()) ~f:(fun vm -> last_vm := vm) ) ;
+        None )
+      else
+        let in_use = max heap (current_vm_words ~heap) in
+        if heap > !peak_heap then peak_heap := heap ;
+        if !last_vm > !peak_vm then peak_vm := !last_vm ;
+        report_crossings in_use ;
+        let in_use =
+          match soft with
+          | Some soft when in_use >= soft && relief_interval_elapsed () ->
+              let after = relieve () in
+              calls_since_vm_read := vm_recheck_calls ;
+              max after (current_vm_words ~heap:after)
+          | _ ->
+              in_use
+        in
+        ( match hard with Some hard when in_use > hard -> Some in_use | _ -> None )
+
+
+let check () = check_with_heap (heap_words ())
+
+
+(* The checkpoints added inside the analysis run one or two orders of magnitude more often than
+   the per-instruction one that already existed upstream (once per callee pre/post pair, once per
+   disjunct). Sample them so the fast path stays cheap: memory cannot move far in a few
+   applications, and the limit is a ceiling with headroom, not an exact budget. *)
+let sample_stride = 16
+
+let calls_since_sample = ref 0
+
+let check_sampled () =
+  if not (is_enabled ()) then None
+  else (
+    incr calls_since_sample ;
+    if !calls_since_sample < sample_stride then None
+    else (
+      calls_since_sample := 0 ;
+      check () ) )
+
+
+
+(** Same as {!check} but raises {!OverHardLimit}. Only call from code whose callers give up on the
+    current procedure and record the omission (Pulse does; other checkers do not). *)
+let check_exn () = Option.iter (check ()) ~f:(fun heap -> raise (OverHardLimit heap))
+
+(** Sampled variant for the inner loops. *)
+let check_sampled_exn () = Option.iter (check_sampled ()) ~f:(fun heap -> raise (OverHardLimit heap))
+
+let hard_limit () = Lazy.force hard_limit_words
+
+let gb_of_words w = float_of_int w *. float_of_int (Sys.word_size_in_bits / 8) /. 1024. /. 1024. /. 1024.
+
+(** one line at the start of the analysis saying what is and is not bounded *)
+let log_configuration () =
+  match (Lazy.force address_space_limit_words, Lazy.force hard_limit_words) with
+  | Some limit, Some ceiling ->
+      L.environment_info
+        "Memory: address space limited to %.2f GB (RLIMIT_AS); relieving memory pressure above \
+         %.2f GB, giving up on the current procedure above %.2f GB@."
+        (gb_of_words limit)
+        (gb_of_words (Option.value (Lazy.force soft_limit_words) ~default:0))
+        (gb_of_words ceiling)
+  | None, Some ceiling ->
+      L.environment_info
+        "Memory: no address-space limit; giving up on the current procedure above %.2f GB of \
+         managed heap (--pulse-max-heap)@."
